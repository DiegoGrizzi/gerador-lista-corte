# Arquivos .bat PRECISAM de fim de linha CRLF — o interpretador de batch do
# cmd.exe se confunde com LF sozinho (já causou um bug real: linhas REM
# sendo lidas como comando). Força isso independente da configuração de
# core.autocrlf de quem clonar o repositório (a máquina de cada loja).
*.bat text eol=crlf

# Arquivos do Docker (Linux) sempre com LF, mesmo num clone no Windows.
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.proxy.yml text eol=lf
.dockerignore text eol=lf

# Scripts de shell (servidor Linux) sempre com LF: com CRLF o bash nem os executa.
*.sh text eol=lf
