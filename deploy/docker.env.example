# Copie para ".env" (ao lado do docker-compose.yml) e ajuste. Tudo é opcional.

# Porta de fora do container (a do servidor).
GERADOR_PORT=5175

# Quem alcança essa porta. 127.0.0.1 = só o próprio computador (padrão).
# 0.0.0.0 = qualquer um na rede; num servidor com endereço público isso é a
# internet inteira, mesmo com firewall (o Docker passa por cima do ufw).
GERADOR_BIND=127.0.0.1

# Reserva de leitura de foto quando o Tesseract falhar. Vazio = desligado.
OCR_SPACE_API_KEY=

# Endereço em que a interface é aberta (CORS). Só muda se não for localhost.
CLIENT_ORIGIN=http://localhost:5175

# Usuário e senha para abrir o sistema. Vazios = abre direto. Preencha os dois
# sempre que o sistema ficar num endereço público.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---- Num domínio, atrás de um proxy com HTTPS (docker-compose.proxy.yml) ----
# Descomente as linhas abaixo. Com elas o container não abre porta no servidor
# e GERADOR_PORT / GERADOR_BIND deixam de valer.
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
#PROXY_NETWORK=nome-da-rede-do-proxy
#CLIENT_ORIGIN=https://gerador.exemplo.com.br
# Teto de CPU (núcleos) e memória do container.
#GERADOR_CPUS=2
#GERADOR_MEMORY=1g
