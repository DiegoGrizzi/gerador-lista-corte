# Copie para ".env" (ao lado do docker-compose.yml) e ajuste. Tudo é opcional.

# Porta de fora do container (a do servidor).
GERADOR_PORT=5175

# Reserva de leitura de foto quando o Tesseract falhar. Vazio = desligado.
OCR_SPACE_API_KEY=

# Endereço em que a interface é aberta (CORS). Só muda se não for localhost.
CLIENT_ORIGIN=http://localhost:5175
