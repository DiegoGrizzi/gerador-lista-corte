# Porta em que o servidor Express vai escutar.
OCR_SERVER_PORT=5175

# Origem (URL) do frontend, usada para liberar o CORS. Ajuste se o cliente
# rodar em outra porta/domínio.
CLIENT_ORIGIN=http://localhost:5173

# Caminho para o executável do Tesseract. Deixe em branco para usar "tesseract"
# do PATH do sistema.
TESSERACT_PATH=

# Idioma usado pelo Tesseract no reconhecimento de texto.
TESSERACT_LANG=por

# Chave de API do OCR.space, usada apenas como fallback quando o Tesseract
# local falhar ou não estiver instalado. Sem essa chave, o fallback fica
# desativado. Obtenha uma chave gratuita em https://ocr.space/ocrapi.
OCR_SPACE_API_KEY=

# Endpoint da API do OCR.space.
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# Quantidade mínima de caracteres úteis que o Tesseract precisa retornar
# para o resultado ser considerado válido (abaixo disso, tenta o fallback).
OCR_MIN_USEFUL_CHARS=15

# Limite de tamanho do corpo das requisições (fotos em base64 podem ser grandes).
OCR_BODY_LIMIT=15mb
